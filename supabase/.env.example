# Supabase Edge Functions ortam değişkenleri
# Bunlar `supabase secrets set` komutuyla veya Supabase Dashboard >
# Edge Functions > Settings üzerinden girilir. GİZLİ TUTULMALIDIR.

API_FOOTBALL_KEY=your_api_football_key_here
